{
  "name": "@aliou/pi-toolchain",
  "version": "0.10.2",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aliou/pi-toolchain"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "toolchain"
  ],
  "pi": {
    "extensions": [
      "./extensions/toolchain/index.ts"
    ],
    "video": "https://assets.aliou.me/github/aliou/pi-toolchain/demo.mp4"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "extensions",
    "schema.json",
    "README.md",
    "!src/**/*.test.ts",
    "!extensions/**/*.test.ts"
  ],
  "type": "module",
  "license": "MIT",
  "private": false,
  "dependencies": {
    "@aliou/pi-utils-settings": "^0.24.0",
    "@aliou/sh": "^0.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@aliou/biome-plugins": "^0.10.0",
    "@biomejs/biome": "^2.4.16",
    "@changesets/cli": "^2.31.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^25.9.3",
    "husky": "^9.1.7",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check",
    "format": "biome check --write",
    "gen:schema": "pi-settings-schema -p src/config/types.ts -t ToolchainConfig -o schema.json --version 0.10.1 --tsconfig tsconfig.json",
    "check:schema": "pi-settings-schema -p src/config/types.ts -t ToolchainConfig -o schema.json --version 0.10.1 --tsconfig tsconfig.json --check",
    "check:lockfile": "pnpm install --frozen-lockfile --ignore-scripts",
    "prepare": "[ -d .git ] && husky || true",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm changeset publish"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
